---
// Stats page: Queries aggregated telemetry from /api/analytics/stats
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy Analytics Dashboard - Streaming Intel Hub</title>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">
  <header class="border-b border-slate-800 px-8 py-4 flex items-center justify-between">
    <a href="/" class="text-lg font-bold text-white">Streaming Intel Hub</a>
    <a href="/" class="text-sm text-blue-400">&larr; Back to Catalog</a>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-8">
    <div>
      <div class="text-xs font-mono uppercase text-emerald-400">Zero-PII Daily Salt Engine</div>
      <h1 class="text-3xl font-extrabold text-white mt-1">Live Platform Analytics</h1>
      <p class="text-sm text-slate-400 mt-2">
        We store ZERO IP addresses and set ZERO cookies. Daily rotating cryptographic salt guarantees mathematical GDPR compliance while tracking unique daily visitors.
      </p>
    </div>

    <!-- Live Metrics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60">
        <div class="text-xs text-slate-400 font-mono uppercase">Total Page Views</div>
        <div id="metric-total" class="text-3xl font-bold text-white mt-2 font-mono">--</div>
      </div>
      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60">
        <div class="text-xs text-slate-400 font-mono uppercase">Views Today</div>
        <div id="metric-today" class="text-3xl font-bold text-blue-400 mt-2 font-mono">--</div>
      </div>
      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60">
        <div class="text-xs text-slate-400 font-mono uppercase">Privacy Protocol</div>
        <div class="text-xs font-mono text-emerald-400 mt-3">SHA256(IP + Salt)</div>
      </div>
    </div>

    <!-- Top Pages & Referrers -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/40 space-y-3">
        <h3 class="text-base font-semibold text-white">Top Ingested Pages</h3>
        <div id="top-pages-list" class="space-y-2 text-xs font-mono text-slate-300">
          Loading metrics...
        </div>
      </div>

      <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/40 space-y-3">
        <h3 class="text-base font-semibold text-white">Device Breakdown</h3>
        <div id="device-breakdown-list" class="space-y-2 text-xs font-mono text-slate-300">
          Loading breakdown...
        </div>
      </div>
    </div>
  </main>

  <script src="/track.js"></script>
  <script>
    async function loadStats() {
      try {
        const res = await fetch('/api/analytics/stats');
        const data = await res.json();
        document.getElementById('metric-total').innerText = data.total_views;
        document.getElementById('metric-today').innerText = data.views_today;

        const pagesEl = document.getElementById('top-pages-list');
        if (data.top_pages && data.top_pages.length > 0) {
          pagesEl.innerHTML = data.top_pages.map(p => `
            <div class="flex justify-between py-1 border-b border-slate-800/60">
              <span class="truncate max-w-[200px]">${p.page}</span>
              <span class="text-blue-400 font-bold">${p.hits} views</span>
            </div>
          `).join('');
        } else {
          pagesEl.innerHTML = '<p class="text-slate-500 italic">No pageviews recorded yet.</p>';
        }

        const devEl = document.getElementById('device-breakdown-list');
        if (data.device_breakdown) {
          devEl.innerHTML = Object.entries(data.device_breakdown).map(([k, v]) => `
            <div class="flex justify-between py-1 border-b border-slate-800/60">
              <span>${k}</span>
              <span class="text-emerald-400 font-bold">${v}</span>
            </div>
          `).join('');
        }
      } catch (e) {
        console.error('Failed to load stats', e);
      }
    }
    window.addEventListener('DOMContentLoaded', loadStats);
  </script>
</body>
</html>
