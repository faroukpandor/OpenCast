---
import Database from 'better-sqlite3';
import path from 'node:path';

// Connect to SQLite at SSG build time
let devices = [];
let issues = [];

try {
  const dbPath = path.resolve(process.cwd(), '../backend/streaming_intel.db');
  const db = new Database(dbPath, { readonly: true });
  devices = db.prepare('SELECT id, name, ecosystem, release_date, specs_json FROM devices ORDER BY id ASC').all();
  issues = db.prepare('SELECT id, device_id, title, description, severity FROM issues ORDER BY id DESC LIMIT 10').all();
  db.close();
} catch (e) {
  // Graceful fallback during isolated builds
  devices = [
    { id: 1, name: "Amazon Fire TV Stick 4K Max", ecosystem: "Amazon", release_date: "2023-10-18" },
    { id: 2, name: "Chromecast with Google TV (4K)", ecosystem: "Google", release_date: "2020-09-30" },
    { id: 3, name: "Walmart onn. Google TV 4K Pro", ecosystem: "Google", release_date: "2024-05-06" },
    { id: 4, name: "Roku Ultra (4802R)", ecosystem: "Roku", release_date: "2022-04-12" }
  ];
  issues = [
    { id: 1, title: "FireOS 8 blocks ADB package installer for third-party APKs", severity: "high" },
    { id: 2, title: "Custom launcher disabled by Fire TV Home update", severity: "critical" },
    { id: 3, title: "Downloader by AFTVnews shortcode fails to fetch APK redirect", severity: "medium" }
  ];
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Streaming Intel Hub - Proprietary Hardware & Sideload Intelligence</title>
  <meta name="description" content="Self-hosted, privacy-first alternative to AFTVnews. Verified ADB commands, hardware specs, and firmware recovery." />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased">
  <!-- Top Bar Contract -->
  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur px-8 py-4 flex items-center justify-between gap-8">
    <a href="/" class="text-lg font-bold tracking-tight text-white whitespace-nowrap shrink-0">
      Streaming Intel Hub
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm text-slate-300">
      <a href="/#devices" class="hover:text-white transition-colors whitespace-nowrap">Hardware Database</a>
      <a href="/#issues" class="hover:text-white transition-colors whitespace-nowrap">ADB Solutions</a>
      <a href="/stats" class="hover:text-white transition-colors whitespace-nowrap">Privacy Analytics</a>
      <a href="/cloudflare-deploy" class="hover:text-white transition-colors whitespace-nowrap">Cloudflare Guide</a>
    </nav>
    <div class="flex items-center gap-3 shrink-0">
      <a href="/stats" class="px-3.5 py-1.5 text-xs font-semibold rounded-md bg-blue-600 hover:bg-blue-500 text-white transition-colors whitespace-nowrap">
        Live Telemetry
      </a>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-12 space-y-16">
    <!-- Hero Section -->
    <section class="text-center max-w-3xl mx-auto space-y-4">
      <div class="text-xs uppercase tracking-widest text-blue-400 font-mono">Zero-SaaS · Self-Hosted · Privacy-First</div>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        The Open-Source Alternative to AFTVnews
      </h1>
      <p class="text-base text-slate-400 leading-relaxed">
        Real-time firmware intelligence, verified ADB bypasses, and hardware teardowns for Fire TV, Google TV, and Roku streaming devices.
      </p>
    </section>

    <!-- Hardware Devices Grid -->
    <section id="devices" class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-white">Streaming Devices</h2>
        <span class="text-xs font-mono text-slate-400">{devices.length} verified hardware profiles</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {devices.map((device) => (
          <a href={`/devices/${device.id}`} class="block p-6 rounded-xl border border-slate-800 bg-slate-900/60 hover:border-slate-700 hover:bg-slate-900 transition group">
            <div class="text-xs text-blue-400 font-semibold mb-2">{device.ecosystem}</div>
            <h3 class="text-lg font-semibold text-white group-hover:text-blue-300 transition-colors">{device.name}</h3>
            <p class="text-xs text-slate-400 mt-2 font-mono">Released: {device.release_date}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Latest Issues & ADB Solutions -->
    <section id="issues" class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-white">System Issues & Workarounds</h2>
        <span class="text-xs font-mono text-slate-400">Scraped & Community-Verified</span>
      </div>
      <div class="space-y-4">
        {issues.map((issue) => (
          <a href={`/issues/${issue.id}`} class="block p-5 rounded-lg border border-slate-800 bg-slate-900/40 hover:bg-slate-900 transition flex items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 mb-1">
                <span class={`text-xs px-2 py-0.5 rounded font-mono ${
                  issue.severity === 'critical' ? 'bg-red-950 text-red-400 border border-red-800' :
                  issue.severity === 'high' ? 'bg-amber-950 text-amber-400 border border-amber-800' :
                  'bg-blue-950 text-blue-400 border border-blue-800'
                }`}>
                  {issue.severity.toUpperCase()}
                </span>
                <span class="text-sm font-semibold text-white">{issue.title}</span>
              </div>
              <p class="text-xs text-slate-400 line-clamp-1">{issue.description}</p>
            </div>
            <span class="text-xs text-blue-400 font-semibold whitespace-nowrap">View Solution &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-800 mt-20 py-8 text-center text-xs text-slate-500">
    <p>Streaming Intel Hub · Self-Hosted & Privacy-First · Zero Third-Party SaaS</p>
  </footer>

  <!-- Vanilla JS Privacy Beacon (No Cookies, Daily Salted) -->
  <script src="/track.js"></script>
</body>
</html>
