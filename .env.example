# Node.js 22.12+ required. Built-in SQLite emits an experimental warning on Node 22.
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/opencast.sqlite

# Optional administrator bootstrap: set ALL THREE. No default account exists.
# Existing accounts are never promoted or overwritten by changing these values.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-long-password

# Optional persistent random secret (at least 32 characters).
# Otherwise a cryptographically random secret is generated and persisted in SQLite.
# ANALYTICS_SECRET=

# Exact public origin, without a path. Required for a public deployment.
# APP_URL=https://cast.example.com
# Number of trusted reverse proxies immediately in front of Node; 0 trusts none.
TRUST_PROXY_HOPS=0
# Defaults to false in development, true in production.
# Compose explicitly defaults to false for its loopback HTTP setup.
# For public HTTPS deployment set APP_URL=https://... and COOKIE_SECURE=true.
COOKIE_SECURE=false

# Knowledge search runs locally, including from the browser's cached catalog.
# No AI API key, external model, or paid service is required.

# Operator opt-in; running feeds also requires an administrator session.
ENABLE_SCRAPERS=false
# Up to five comma-separated valid UC... YouTube channel IDs.
YOUTUBE_CHANNEL_IDS=

# Public operator identity and privacy request contact (email or HTTPS URL).
# Leave unset only for local development; configure before public community use.
OPERATOR_NAME=
PRIVACY_CONTACT=

# Reddit JSON access stays off until the operator obtains Reddit's permission.
# This flag is an operator attestation, not automatic permission from Reddit.
REDDIT_ACCESS_APPROVED=false
