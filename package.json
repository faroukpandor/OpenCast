{
  "name": "opencast",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.js",
    "build": "npm run lint && vite build && npm run build:server",
    "preview": "NODE_ENV=production node dist-server/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 --test-timeout=60000 tests/*.test.ts",
    "test:e2e": "tsx scripts/prepare-browser.ts && playwright test",
    "check": "npm run security:check && npm run lint && npm test && npm run build",
    "audit:dependencies": "npm audit --omit=dev",
    "clean": "rm -rf dist",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js && esbuild scripts/backup-db.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/backup-db.js",
    "test:e2e:production": "npm run build && tsx scripts/prepare-browser.ts && E2E_PRODUCTION=true playwright test e2e/production.spec.ts",
    "security:check": "tsx scripts/security_check.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "verify:https": "npm run build && tsx scripts/verify-https.ts",
    "verify:container": "bash scripts/verify-container.sh",
    "probe:feeds": "tsx scripts/probe-feeds.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/tar-fs": "^2.0.4",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-react": "^5.2.0",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "tar-fs": "^3.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "license": "MIT"
}
